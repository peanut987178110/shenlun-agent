# 复制为 .env 后修改。.env 不进仓库。

# 服务端口。默认 8100，避开其他项目常用的 8000
APP_PORT=8100
#
# 模型网关（OpenAI 兼容协议）。
# 留空时依次尝试：系统环境变量 ANTHROPIC_BASE_URL / ANTHROPIC_AUTH_TOKEN（自动补 /v1）；都没有则
# 识别改为手动录入、批改由规则引擎完成，AI 出题、申论助手、真题首次批改不可用。
# 示例：DeepSeek  https://api.deepseek.com/v1
#       通义千问  https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=
LLM_API_KEY=
# 知情同意文案里展示给用户的服务名称，如实填写
LLM_PROVIDER_LABEL=未配置

# 评分 / 出题用中档模型；评分点生成与证据复核用大模型；拍照识别用视觉模型。
# 换成你的网关实际提供的模型名，例如 deepseek-chat / deepseek-reasoner / qwen-vl-max
LLM_MODEL_MEDIUM=claude-sonnet-5
LLM_MODEL_LARGE=claude-opus-5
LLM_MODEL_VISION=claude-sonnet-5

# 首次启动创建 student / teacher 两个演示账号，随机密码打印在启动日志里。
# 正式部署请设为 false
SEED_DEMO_ACCOUNTS=true

# 令牌签名密钥。留空则首次启动自动生成到 backend/data/secret.key
APP_SECRET_KEY=
